    "impacts": [
      {
        "stage": 16,
        "statement": "Major flooding on homes along Abrigador Trail, Willow Drive, Riverbank Street and Konkle Drive. In Comstock Park and Plainfield Township approximately 100 homes affected by flooding."
      },
      {
        "stage": 14,
        "statement": "Homes along Willow Drive and Abrigador Trail have flooded basements and Abrigador Trail is closed. Riverbank Street northeast in Plainfield Township is flooded and homes along Riverbank Street have flooded basements. Konkle Drive northeast in Plainfield township is flooded."
      },
      {
        "stage": 13,
        "statement": "Abrigador Trail is underwater and minor flooding of homes occurs along Abrigador Trail and Willow Drive."
      },
      {
        "stage": 12,
        "statement": "Expect minor flooding of homes along Abrigador Trail."
      },
      {
        "stage": 11,
        "statement": "River is bankfull."
      }
    ],
