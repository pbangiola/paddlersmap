    "impacts": [
      {
        "stage": 14,
        "statement": "US-41 southbound is threatened south of the river."
      },
      {
        "stage": 13.5,
        "statement": "Shelby levee overtops leading to potential inundation of numerous structures and roads. Widespread inundation of the floodplain may reach up to 4 miles from the river."
      },
      {
        "stage": 13,
        "statement": "Water reaches the top of the levees in Sumava Resorts. Water reaches the top of levees near Shelby."
      },
      {
        "stage": 12.5,
        "statement": "US-41 northbound is inundated south of the river. Multiple residences are threatened along Westwood Drive and Island Boulevard near Shelby."
      },
      {
        "stage": 12,
        "statement": "IN-55 is threatened south of the river. County Road 1200W/Range Line Road is threatened north of the river. County Road 1150N is threatened at Sumava Resorts."
      },
      {
        "stage": 11.5,
        "statement": "Low-lying residences are threatened along Bluegrass Road east of Sumava Resorts and along Westwood Drive and Island Boulevard near Shelby."
      },
      {
        "stage": 10.5,
        "statement": "Water overflows low-lying river banks along Bluegrass Road east of Sumava Resorts and along Westwood Drive and Island Boulevard near Shelby. Water begins to be diverted through the Blackberry Marsh Spillway to reduce flood impacts."
      },
      {
        "stage": 10,
        "statement": "Stateline Road is threatened near the river west of Schneider."
      },
      {
        "stage": 9,
        "statement": "Low-lying agricultural land is inundated."
      },
      {
        "stage": 7.5,
        "statement": "Water overtops low-lying banks in forest land near the Illinois/Indiana state line."
      }
    ],
