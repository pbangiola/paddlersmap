    "impacts": [
      {
        "stage": 13.64,
        "statement": "Water overtops the Wilson Avenue bridge."
      },
      {
        "stage": 12.5,
        "statement": "Water reaches the bottom of the Chicago Drive bridge."
      },
      {
        "stage": 12,
        "statement": "Nearly all bridges over Buck Creek in Grandville will be closed, and many homes will be flooded."
      },
      {
        "stage": 11.5,
        "statement": "Water reaches the doors of the Brookcrest Retirement Community."
      },
      {
        "stage": 10.76,
        "statement": "Water reaches the bottom of the Wilson Avenue Bridge."
      },
      {
        "stage": 10.5,
        "statement": "Water begins to flow across Ivanrest Ave and Canal Ave. Many homes surrounded by water, and a few of the homes/buildings in the lowest parts of the river start to take on water, including at Mill Race Park."
      },
      {
        "stage": 9.5,
        "statement": "Water spills into parking lots at Brookcrest Retirement Community. Widespread flooding of yards starts to occur on the lower parts of the creek."
      },
      {
        "stage": 9,
        "statement": "Water spills onto the access driveway at Lemery Park."
      },
      {
        "stage": 8.5,
        "statement": "The water hits the bottom of the bridge at Clay Ave and 54th street."
      },
      {
        "stage": 8,
        "statement": "Water starts to creep into a few yards near Ivanrest and 34th street."
      },
      {
        "stage": 7.5,
        "statement": "The river is generally bankfull. Flooding begins at Kaufman Golf Course and at low sections along Buck Creek Trail near Mill Race Park."
      },
      {
        "stage": 7,
        "statement": "Overflow begins at some of the lowest spots along the river."
      },
      {
        "stage": 6.5,
        "statement": "Water starts to affect the bike trail near the creek in Wedgewood Park."
      }
    ],
