    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 11.1,
        "statement": "The river is at the 100 year flood level."
      },
      {
        "stage": 11,
        "statement": "Business areas near Indiana University at South Bend campus are flooded. Residents in River Commons, near Keller Park and Riverside Drive between Marion and Bartlett are flooded in their basements. Street flooding closes portions of Northshore Drive and Northside Blvd. Evacuations may be necessary and the wastewater treatment plant will be completely flooded."
      },
      {
        "stage": 10,
        "statement": "Flooding affects commercial areas near Indiana University at South Bend campus along Northside Blvd."
      },
      {
        "stage": 9,
        "statement": "Major flooding is in progress. Flooding almost completely submerges parks and floods local streets near the St. Joseph River."
      },
      {
        "stage": 8,
        "statement": "Flood waters begin to affect river parks and roads and may affect portions of Northside Blvd in the area of Veterans Memorial Park, and Riverside Drive in the areas south of Leeper Park, by Keller Park and Woodland Park. High water may cause flooding of basements and interfere with some commercial activities."
      },
      {
        "stage": 7,
        "statement": "Flooding is confined to park land and park roads. Some backyard flooding may occur in low lying residential areas near the river."
      },
      {
        "stage": 6,
        "statement": "Flooding is confined to mostly park land and golf courses. Leeper Park and Petro golf courses begin to flood."
      },
      {
        "stage": 5.5,
        "statement": "The river reaches flood stage with the lowest residential areas beginning to flood."
      }
    ],
