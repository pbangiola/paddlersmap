    "impacts": [
      {
        "stage": 8,
        "statement": "Numerous structures and roadways are threatened in South Deering, East Side, Hegewisch, and South Chicago community areas of Chicago, and near Burnham."
      },
      {
        "stage": 7.5,
        "statement": "I-94 threatened along the west shore of Lake Calumet. Backwater causes Indian Creek to threaten residences along Avenue O and 129th Street in the Hegewisch Community Area of Chicago."
      },
      {
        "stage": 7,
        "statement": "Backwater causes Indian Creek to threaten residences along Green Bay Avenue in the Hegewisch Community Area of Chicago. Industrial property threatened along Carondelet Avenue in the South Deering Community Area of Chicago. Doty Avenue threatened along the west shore of Lake Calumet. Backwater casues Indian Creek to threaten athletic fields along Carondelet Avenue in the South Deering Community Area of Chicago."
      },
      {
        "stage": 6.5,
        "statement": "Structures may be threatened at Calumet Harbor and the Calumet River near 95th Street and Harbor Avenue. Residences may be threatened along 127th Street and 128th Street in the Hegewisch Community Area of Chicago."
      },
      {
        "stage": 6,
        "statement": "Industrial property and parking lots threatened near Torrence Avenue and 126th Place in South Deering and Hegewisch community areas of Chicago."
      },
      {
        "stage": 5,
        "statement": "Water begins to inundate low-lying areas along Lake Michigan near Calumet Harbor. Portions of Heron Pond Park inundated. Backwater causes Indian Creek and Wolf Lake to inundate low-lying park land along Avenue O."
      }
    ],
