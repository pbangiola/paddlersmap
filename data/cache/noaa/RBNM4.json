    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 18.3,
        "statement": "Flood of record. Major flooding of homes along Vanlopik Road and homes along Limberlost Road are flooded. Vanlopik Road is under 4 to 5 feet of water. Water reaches seat-cushion level in several homes."
      },
      {
        "stage": 17,
        "statement": "Vanlopik Road is 3 to 4 feet under water. Moderate flooding of several homes in Vanlopik subdivision occurs."
      },
      {
        "stage": 16,
        "statement": "Vanlopik Road is 2 to 3 feet under water. Moderate flooding of several homes on the east end of Vanlopik subdivision occurs."
      },
      {
        "stage": 15,
        "statement": "Vanlopik Road is 1 to 2 feet under water. Moderate flooding of several homes on the east end of Vanlopik subdivision occurs."
      },
      {
        "stage": 13.92,
        "statement": "Several homes in Vanlopik subdivision are surrounded by water."
      },
      {
        "stage": 13.7,
        "statement": "Two houses in the Vanlopik subdivision begin to be surrounded by water."
      },
      {
        "stage": 13.6,
        "statement": "Eastern edge of Vanlopik and the western edge of Limberlost Roads begin to flood. Flooding begins to occur in low lying areas in Deer Creek Park."
      },
      {
        "stage": 13.3,
        "statement": "Minor flooding begins in low areas."
      },
      {
        "stage": 13,
        "statement": "River is bankfull."
      }
    ],
