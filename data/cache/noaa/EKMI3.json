      },
      {
        "stage": 30,
        "statement": "Residential flooding from Second Street to and including South Shore Drive. Several city streets become impassible."
      },
      {
        "stage": 29,
        "statement": "Extensive flooding of the commercial district along east Jackson Street is in progress."
      },
      {
        "stage": 28,
        "statement": "Extensive street flooding is in progress."
      },
      {
        "stage": 27,
        "statement": "Water begins to affect businesses on east Jackson Street. Flooding affects a few first floor residences in the South Shore Drive area across from the hospital."
      },
      {
        "stage": 25,
        "statement": "Basement flooding begins in residential areas of the 6th Street area and along South Shore Drive."
      },
      {
        "stage": 24,
        "statement": "Island park in Elkhart and Kamm's Island in Mishawaka begin to flood."
