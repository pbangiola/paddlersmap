    "impacts": [
      {
        "stage": 13.5,
        "statement": "Water reaches the top of the west bank levees in Lyons and McCook."
      },
      {
        "stage": 12,
        "statement": "Water reaches the top of the levees in Lyons and McCook."
      },
      {
        "stage": 11.5,
        "statement": "Widespread inundation of industrial property and structures north of the river in McCook. Numerous residences threatened near the river in Lyons."
      },
      {
        "stage": 11,
        "statement": "Structures threatened at Brookfield Zoo."
      },
      {
        "stage": 10.5,
        "statement": "Residences threatened between river and 39th Street in Riverside. Without flood protection from levees, widespread inundation of industrial property and structures would occur north of the river in McCook."
      },
      {
        "stage": 10,
        "statement": "US-34 (Ogden Avenue) threatened along the River in Lyons."
      },
      {
        "stage": 9.5,
        "statement": "Parking areas at Brookfield Zoo threatened. Industrial parking area near the river and I-55 is threatened."
      },
      {
        "stage": 9,
        "statement": "Residences threatened near the confluence of Des Plaines River and Salt Creek."
      },
      {
        "stage": 8.5,
        "statement": "IL-171 (1st Avenue) threatened near Brookfield Zoo. Water may begin to overflow into the Chicago Sanitary & Ship Canal near Willow Springs."
      },
      {
        "stage": 8,
        "statement": "Park areas are inundated near the confluence of Des Plaines River and Salt Creek."
      },
      {
        "stage": 7.5,
        "statement": "Low-lying sections of Miller Meadow, Indian Gardens, Cermak Woods, Ottawa Trail Woods, and other forest land along the river are inundated."
      },
      {
        "stage": 7,
        "statement": "Water begins to overflow banks in adjacent forest preserve areas."
      },
      {
        "stage": 4,
        "statement": "Without flood protection from levees, water would begin to bypass the main river channel through Chicago Portage toward the Chicago River Basin and areas once covered by Mud Lake."
      }
    ],
