    "impacts": [
      {
        "stage": 10,
        "statement": "US-12 and Milwaukee District Railroad tracks are threatened near Fox Lake."
      },
      {
        "stage": 9,
        "statement": "Widespread inundation of roadways and structures along the Fox Chain of Lakes reaches up to 2 blocks inland threatening numerous businesses and a post office in Fox Lake."
      },
      {
        "stage": 8.5,
        "statement": "Grass Lake Road threatened west of Antioch. "
      },
      {
        "stage": 8,
        "statement": "Lake County Sheriffs Office Marine Unit threatened west of Fox Lake."
      },
      {
        "stage": 7.5,
        "statement": "Numerous residences threatened along Lake Shore Drive north of Fox Lake. Fox Waterway Agency threatened in Fox Lake. Grand Avenue threatened near Lakeland Shopping Center in Fox Lake."
      },
      {
        "stage": 7,
        "statement": "Numerous residences threatened along Venn Road, Clark Street, and Witt Road west of Antioch. Residences threatened along Fairfax Road, Lake Lane, and Tremont Road in Fox Lake. Numerous structures threatened at marinas along the lakes. Parking lots are threatened at Lakeland Shopping Center in Fox Lake. Kings Road threatened in Fox Lake, cutting off evacuation route for Kings Island. Lagoon Road and Matts Road are threatened in Fox Lake. Greenwood Avenue is threatened north of Fox Lake. "
      },
      {
        "stage": 6.5,
        "statement": "A few residences are threatened along Eagle Point Road. Anchorage Drive, Knollwood Road, Oak Lane, and Spring Road are threatened in Fox Lake. Bayview Lane is threatened southwest of Fox Lake. Stanton Point Road is threatened east of Fox Lake. Large portions of Cedar Island are inundated."
      },
      {
        "stage": 6,
        "statement": "Low-lying residences are threatened along Park Avenue and Marine Drive in Fox Lake. The Island RV Park is threatened off Lakeside Place north of Fox Lake. Lakeside Lane, Wells Street at Oak Street, Eagle Point Road, and roadways at Watts Marina are threatened in Fox Lake. Venn Road, Clark Street, and Witt Road are threatened west of Antioch."
      },
      {
        "stage": 5.5,
        "statement": "Park Avenue, Marine Drive, and Atwater Parkway are threatened in Fox Lake. Water overflows low-lying banks along Fox Lake in Fox Lake Hills."
      },
      {
        "stage": 5,
        "statement": "Fox Waterway Agency considers \"no wake\" order for the Fox River Chain of Lakes from Pistakee Lake to the Wisconsin border. Water overflows low-lying banks along Fox Lake, Pistakee Lake, and Nippersink Lake in Fox Lake."
      }
    ],
