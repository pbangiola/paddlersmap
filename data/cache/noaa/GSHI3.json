    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 13,
        "statement": "At this level, the Goshen wastewater plant operations are likely impacted. "
      },
      {
        "stage": 12.5,
        "statement": "All-time record flood is in progress with many residences flooded. Water as high as four feet can be expected in some commercial areas."
      },
      {
        "stage": 11,
        "statement": "A major flood is in progress with several streets and US 33 through Goshen flooded. Southeast Elkhart also floods. Many evacuations of residential areas are necessary."
      },
      {
        "stage": 10,
        "statement": "Several residential streets are flooded in Goshen. US 33 begins to flood. Flooding from Chicago Poke Plaza reaches residential areas near the intersection of Indiana and Berkey Avenues in Goshen."
      },
      {
        "stage": 9,
        "statement": "Water closes Chicago Avenue and Denver Street in Goshen. Rogers Park is completely flooded."
      },
      {
        "stage": 8,
        "statement": "Some residential and commercial properties near SR 119 are affected by high water."
      },
      {
        "stage": 7,
        "statement": "The river reaches flood stage. Goshen, Shanklin, and Rogers Park in Goshen begin to flood. Island, Studebaker, and American Parks in Elkhart begin to flood."
      },
      {
        "stage": 5,
        "statement": "The very lowest areas along the Elkhart River begin to flood."
      },
      {
        "stage": 1.86,
        "statement": "Lowest river observation during 2012 drought. "
      }
    ],
