    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 16,
        "statement": "N Pine St, Bridge St, N Dodge St, E Chestnut St, E Jefferson St, Fox St, Congress St homes affected, Michigan Ave, Delaware Ave, Maryland Ave flood. Floodwaters affect roads and homes north of E. Jefferson St: North Spring St, North Main St, N Wisconsin St, Capital St, E Washington St. Flooded areas: RR tracks at E Jefferson St, Parking lots between Dodge St and Bridge St, Substation off Congress St, Wehmhoff Jucker Park pedestrian bridges partially flood."
      },
      {
        "stage": 15,
        "statement": "Congress Ave, Burlington substation, Fox St, Bridge St, N Dodge St flood. Water approaches N Pine St, E Chestnut St, E Jefferson St, RR tracks along Bridge St. Floodwaters affect homes on the following streets north of East Jefferson St: North Spring St, North Main St. and North Wisconsin St. Sidewalk on the west side of the river near Jefferson Street bridge floods. Pedestrian bridges in Wehmhoff Jucker Park flood."
      },
      {
        "stage": 14,
        "statement": "Floodwaters affect North Spring Street, North Main Street and North Wisconsin Street. A portion of Brever Road is flooded. Sidewalk on the west side of the river near Jefferson Street bridge floods. Part of White River State Trail and Seven Waters Trail flooded. Riverside Park, Veterans Park, Congress Fields and Wehmhoff Jucker Park flooded."
      },
      {
        "stage": 13,
        "statement": "Floodwaters affect North Spring Street and North Main Street adjacent to the river. Water covers a portion of Brever Road. Water in the parking lot at Veteran's Terrace. Part of White River State Trail and Seven Waters Trail floods. Riverside Park, Veterans Park, Congress Fields and Wehmhoff Jucker Park floods."
      },
      {
        "stage": 12,
        "statement": "Water covers a portion of Brever Road. Water in the parking lot at Veteran's Terrace. Part of White River State Trail floods. Riverside Park floods. "
      },
      {
        "stage": 11,
        "statement": "Floodwaters cover a portion of Brever Road. Floodwaters affect parts of Riverside Park."
      },
      {
        "stage": 10,
        "statement": "Part of Riverside Park floods. There is minor lowland flooding in the Burlington area."
      },
      {
        "stage": 9,
        "statement": "There is minor lowland flooding in the Burlington area."
      }
    ],
