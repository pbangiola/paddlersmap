    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 17,
        "statement": "Water over the 13th street bridge, flooding nearby intersections and approaching or impacting homes along the river from the area in the Lincoln Village and Polonia neighborhoods from 16th to 6th St. Water near or up to the bottom of bridges."
      },
      {
        "stage": 16,
        "statement": "Water touches 13th St bridge and may flood nearby intersections. River is outside of the concrete lined channel and up to road guardrails in the Lincoln Village and Polonia neighborhoods from 16th to 6th St. Water impacts roads and yards of homes along the river. Water approaching the bottom of bridges."
      },
      {
        "stage": 15,
        "statement": "River is 1 to 2 feet above the top of the concrete lined channel and may impact roads and yards of homes along the river in the Lincoln Village and Polonia neighborhoods from 16th to 6th St."
      },
      {
        "stage": 14,
        "statement": "Water is about 1 foot over the top of the concrete lined channel of the Kinnickinnic River from 16th to 6th St."
      },
      {
        "stage": 13,
        "statement": "Water is near the top of the concrete lined channel of the Kinnickinnic River from 16th to 6th st."
      },
      {
        "stage": 12,
        "statement": "Parts of Jackson Parkway flooded. Jackson Park floods."
      },
      {
        "stage": 11,
        "statement": "Flooding in Jackson Park and surrounding low land areas of the Kinnickinnic Parkway parkland."
      }
    ],
