    "impacts": [
      {
        "stage": 18,
        "statement": "Inundation of the floodplain reaches more than 1 block from the river in Algonquin."
      },
      {
        "stage": 17.5,
        "statement": "Main Street is threatened in Algonquin."
      },
      {
        "stage": 16.5,
        "statement": "IL-176 threatened near Holiday Hills."
      },
      {
        "stage": 16,
        "statement": "Numerous structures are threatened along Main Street in Algonquin. North Water Reclamation Facility property in Elgin is threatened."
      },
      {
        "stage": 15.5,
        "statement": "Algonquin Road (IL-62) is threatened west of the river in Algonquin."
      },
      {
        "stage": 15,
        "statement": "Inundation reaches up to 2 blocks from the river in Willow Lake Estates in Elgin. Railroad tracks are threatened in downtown Elgin. Multiple structures threatened in downtown Carpentersville. Duncan Avenue threatened north of Elgin."
      },
      {
        "stage": 14.5,
        "statement": "Widespread inundation of roadways and structures reaches 2 blocks from the river near Freeman Park north of downtown East Dundee. A few structures threatened along 1st Street in West Dundee."
      },
      {
        "stage": 14,
        "statement": "Residences threatened along Riverview Drive and Holiday Drive in Holiday Hills. Residences threatened along Riverside Drive West south of McHenry. Structures threatened along North Harrison Street in Algonquin. A few structures threatened along Washington Street in Carpentersville. Algonquin Wastewater Treatment Facility property threatened. Main Street threatened in Carpentersville."
      },
      {
        "stage": 13.5,
        "statement": "Backwater causes Crystal Creek to threaten structures near the village hall in Algonquin. Multiple structures threatened along Wenholz Avenue, Michigan Avenue, North Street, Barrington Avenue, and 2nd Street in East Dundee."
      },
      {
        "stage": 13,
        "statement": "A few structures threatened along Water Street in East Dundee. A few structures threatened along 2nd Street in West Dundee. Structures along Riverside Drive and Grove Ave are threatened in Elgin. Backwater causes Crystal Creek to threaten low-lying sections of Towne Park in Algonquin."
      },
      {
        "stage": 12.5,
        "statement": "Residences threatened along Edwards Avenue in East Dundee. Prairie Trail is threatened at the river in Algonquin. Parking lots threatened in downtown Carpentersville. Low-lying parking lots threatened at Judson College in Elgin."
      },
      {
        "stage": 12,
        "statement": "Structures threatened along River Street, Johnson Street, and Maiden Lane in East Dundee. North Harrison Street threatened near Riverside Park in Algonquin. Washington Street threatened in Carpentersville. Water Street, Edwards Avenue, and Elgin Avenue threatened in East Dundee. Bayview Road threatened in Elgin. Low-lying areas of Festival Park are threatened in Elgin."
      },
      {
        "stage": 11.5,
        "statement": "Residences threatened along Oceola Drive in Algonquin. A few residences threatened along McBride Street in Elgin. Jayne Street and Beach Drive threatened in Algonquin. River Street threatened in East Dundee. Jerusha Avenue threatened in Elgin. Fox River Trail threatened between East Dundee and Elgin."
      },
      {
        "stage": 11,
        "statement": "Structures threatened near Elgin Avenue and Corey Street south of East Dundee. Lincoln Avenue threatened in West Dundee. Filip Street and Fox River Drive threatened in Algonquin. Fox River Trail threatened south of downtown Elgin."
      },
      {
        "stage": 10.5,
        "statement": "Structures threatened along Fox River Drive in East Dundee. Parking lots threatened in downtown West Dundee. Low-lying sections of Cornish Park are inundated in Algonquin. Low-lying sections of Trout Park inundated north of Elgin."
      },
      {
        "stage": 10,
        "statement": "Winaki Trail and Onaway Trail are threatened south of Algonquin. Athletic fields inundated at Judson College in Elgin."
      },
      {
        "stage": 9.5,
        "statement": "Fox River Drive threatened in East Dundee. Boathouses threatened along the river in Cary."
      },
      {
        "stage": 9,
        "statement": "Water overflows low-lying river banks along Grove Street in Valley View, along River Shore Drive in Cary, and along Riverview Drive and Holiday Drive in Holiday Hills."
      },
      {
        "stage": 8,
        "statement": "Low-lying trails threatened at Walton Island Park in Elgin."
      }
    ],
