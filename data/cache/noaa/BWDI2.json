    "flowUnits": "cfs",
    "impacts": [
      {
        "stage": 14,
        "statement": "Widespread inundation of structures and roadways in the floodplain reaches multiple blocks from the creek in Northlake, Stone Park, Melrose Park, Bellwood, and Westchester. Kindred Hospital Chicago Northlake may be threatened. Northlake Fire Department may be threatened. Union Pacific West railroad tracks are threatened in Bellwood."
      },
      {
        "stage": 13,
        "statement": "A few residences may be threatened off Cermak Road near the creek in Broadview. North Avenue is threatened in Northlake. Lake Street is threatened in Stone Park. Roosevelt Road is threatened in Westchester."
      },
      {
        "stage": 12.5,
        "statement": "I-280 (Eisenhower Expressway) is threatened in Bellwood and Westchester. Manheim Road is threatened in Stone Park."
      },
      {
        "stage": 12,
        "statement": "Numerous residences are threatened at Meadowcreek Mobile Home Park and near Lake Street and Manheim Road in Melrose Park and Stone Park. A few residences are threatened off Harrison Street near the creek in Bellwood. St Charles Road, Washington Boulevard, and Madison Street are threatened in Bellwood."
      },
      {
        "stage": 11,
        "statement": "Numerous minor roadways are threatened near the creek in Northlake, Stone Park, Melrose Park."
      },
      {
        "stage": 10.5,
        "statement": "A few roadways are threatened at Meadowcreek Mobile Home Park in Melrose Park and Stone Park. Low-lying sections of Stevenson Park are inundated in Bellwood."
      },
      {
        "stage": 9.5,
        "statement": "Water begins to be diverted into Addison Creek Reservoir to reduce flood impacts."
      },
      {
        "stage": 8,
        "statement": "Low-lying trails are threatened near Hansen Park in Northlake."
      },
      {
        "stage": 5,
        "statement": "Water overtops low-lying banks near Hansen Park in Northlake."
      }
    ],
