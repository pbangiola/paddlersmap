      },
      {
        "stage": 10.5,
        "statement": "IL-25 (St Charles Street) may be threatened near the creek."
      },
      {
        "stage": 10,
        "statement": "Widespread inundation of structures and roadways in the floodplain reaches up to two blocks from the creek near IL-25 (St Charles Street) and Unity Park. Water begins to bypass the main channel toward structures along Dixon Avenue near Cookane Avenue. Numerous industrial structures threatened near IL-25 (St Charles Street)."
      },
      {
        "stage": 9,
        "statement": "Widespread inundation of structures and roadways in the floodplain reaches several blocks from the creek north of Villa Street near Prairie Park."
      },
      {
        "stage": 8,
        "statement": "Numerous residences are threatened along Ramona Avenue near Villa Street. Varsity Drive is threatened."
      },
      {
        "stage": 7,
        "statement": "Campus Drive is threatened near Elgin High School."
      },
      {
        "stage": 6.5,
        "statement": "A few residences are threatened near Unity Park. Raymond Street is threatened."
      },
      {
        "stage": 6,
        "statement": "Hammond Avenue is threatened near Illinois Avenue. Low-lying sections of Unity Park inundated."
      },
      {
        "stage": 5.5,
        "statement": "Ramona Avenue is threatened near Villa Street."
      },
      {
        "stage": 4,
